apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: opslab
  namespace: argocd
spec:
  project: default
  source:
    repoURL: https://github.com/varel183/opslab.git
    targetRevision: main
    path: helm/opslab
    helm:
      valueFiles:
        - values-dev.yaml
        - values-gitops.yaml
  destination:
    server: https://kubernetes.default.svc
    namespace: opslab-gitops
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true

